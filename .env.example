# ==============================================================================
# TIRMA Environment Variables Template
# Copy this file to .env.local to configure local development settings.
# Never commit real API keys or secrets to version control.
# ==============================================================================

# Google Gemini API Key for Tirma Tea Assistant (Required for live AI responses)
# Generate a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemini Model (Optional, defaults to gemini-2.5-flash)
# Supported models: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
